{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "types": [],
    "baseUrl": ".",
    "typeRoots": ["./node_modules/@types"],
    "paths": {
      "@amazon-devices/react-native-async-storage__async-storage": ["./src/platform/asyncStorage.ts"],
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"]
    }
  },
  "include": ["src", "../../src/addons", "../../src/storage", "../../src/types.ts"]
}
