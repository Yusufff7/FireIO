<?xml version="1.0" encoding="UTF-8"?>
<!-- Proof-of-concept for the Samsung (Tizen) port: plays one stream from the
     configured addons through the TV's native player (AVPlay) to confirm it
     handles MKV — seeking, audio tracks, subtitles — before the real app is
     built on it. -->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://github.com/Yusufff7/FireIO/tizen-poc" version="0.1.0" viewmodes="maximized">
  <tizen:application id="fireiopoc0.FireIOPoc" package="fireiopoc0" required_version="4.0"/>
  <content src="index.html"/>
  <icon src="icon.png"/>
  <name>FireIO Test</name>
  <!-- Addon and stream hosts vary by user, so the app may talk to any origin. -->
  <access origin="*" subdomains="true"/>
  <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:profile name="tv-samsung"/>
  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable"
                 encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
